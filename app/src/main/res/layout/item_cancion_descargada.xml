<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPrincipal"
    android:clickable="true"
    android:focusable="true"
    android:padding="8dp">

    <ImageView
        android:id="@+id/imgCancion"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="Imagen de la canción"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtNombreCancion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/abril_fatface"
        android:textColor="@color/blancoAgradables"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgCancion"
        app:layout_constraintTop_toTopOf="@id/imgCancion"
        tools:text="Kotlin" />

    <TextView
        android:id="@+id/txtNombreArtista"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/abril_fatface"
        android:textColor="@color/colorDetalles"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgCancion"
        app:layout_constraintTop_toBottomOf="@id/txtNombreCancion"
        tools:text="Moha" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/btnEliminar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:contentDescription="Eliminar canción"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_fileName="borrar_animation.json"
        app:lottie_loop="false" />
</androidx.constraintlayout.widget.ConstraintLayout>