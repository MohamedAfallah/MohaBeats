<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrincipal"
    android:fitsSystemWindows="true"
    tools:context=".ui.view.actividades.PaginaInicial">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="113dp"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        app:layout_constraintDimensionRatio="W,126:55"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.056"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.30"
        app:srcCompat="@drawable/moha_beats_removebg_preview" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_menu_hamburguesa"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_fileName="menu_icon.json"
        app:lottie_loop="false" />

    <FrameLayout
        android:id="@+id/fragContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/reproductorMiniContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo" />

    <FrameLayout
        android:id="@+id/reproductorMiniContainer"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorDetalles"
        app:itemIconSize="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

    <FrameLayout
        android:id="@+id/reproductorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorPrincipal"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/overlay_dimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/menu_flotante_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@color/colorDetalles"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.75">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="?attr/actionBarSize"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/abril_fatface"
                android:text="@string/opciones_de_perfil"
                android:textColor="@color/colorPrincipal"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menu_item_mis_posts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/abril_fatface"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/menu_item_mis_posts"
                android:textColor="@color/colorPrincipal"
                android:textSize="18sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/colorPrincipal" />

            <TextView
                android:id="@+id/menu_item_historial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/abril_fatface"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/menu_item_historial"
                android:textColor="@color/colorPrincipal"
                android:textSize="18sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/colorPrincipal" />

            <TextView
                android:id="@+id/menu_item_descargas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/abril_fatface"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/menu_item_descargas"
                android:textColor="@color/colorPrincipal"
                android:textSize="18sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/colorPrincipal" />

            <TextView
                android:id="@+id/menu_item_cerrar_sesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/abril_fatface"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/menu_item_cerrar_sesion"
                android:textColor="@color/colorPrincipal"
                android:textSize="18sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_menu_flotante"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|top"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/colorPrincipal" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>