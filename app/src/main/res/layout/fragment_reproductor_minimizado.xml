<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reproductorMinimizado"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="#4D0D0D0D">

    <ImageView
        android:id="@+id/imgAlbumMini"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bordes_redondeados"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/moha_beats_removebg_preview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/txtTituloMini"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/blancoAgradables"
        android:textSize="16sp"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="@font/abril_fatface"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/imgAlbumMini"
        app:layout_constraintTop_toTopOf="@id/imgAlbumMini"
        app:layout_constraintEnd_toStartOf="@id/btnPlayPauseMini" />

    <TextView
        android:id="@+id/txtArtistaMini"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/colorDetalles"
        android:textSize="14sp"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="@font/abril_fatface"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/imgAlbumMini"
        app:layout_constraintTop_toBottomOf="@id/txtTituloMini"
        app:layout_constraintBottom_toBottomOf="@id/imgAlbumMini"
        app:layout_constraintEnd_toStartOf="@id/btnPlayPauseMini" />

    <ImageView
        android:id="@+id/btnPlayPauseMini"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:padding="4dp"
        android:src="@drawable/ic_reproducir"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="Botón play/pause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="HardcodedText" />
</androidx.constraintlayout.widget.ConstraintLayout>



