<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    tools:background="@color/black">

    <ImageView
        android:id="@+id/imagenCancion"
        android:layout_width="66dp"
        android:layout_height="64dp"
        android:background="@drawable/bordes_redondeados"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <TextView
        android:id="@+id/nombreCancion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/abril_fatface"
        android:textColor="@color/blancoAgradables"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@id/imagenCancion"
        app:layout_constraintTop_toTopOf="@id/imagenCancion"
        app:layout_constraintEnd_toStartOf="@id/iconReproducir"
        app:layout_constraintHorizontal_bias="0.0"
        android:layout_marginStart="16dp"
        tools:text="Mohamed" />

    <TextView
        android:id="@+id/nombreArtista"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/abril_fatface"
        android:textColor="@color/grisSuave"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/nombreCancion"
        app:layout_constraintTop_toBottomOf="@id/nombreCancion"
        app:layout_constraintEnd_toStartOf="@id/iconReproducir"
        app:layout_constraintHorizontal_bias="0.0"
        tools:text="Artista" />

    <ImageView
        android:id="@+id/iconReproducir"
        android:layout_width="33dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_reproducir"
        app:layout_constraintEnd_toStartOf="@id/iconFavorito"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="16dp" />

    <ImageView
        android:id="@+id/iconFavorito"
        android:layout_width="33dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_favorito"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="8dp" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieFavorito"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:visibility="gone"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_fileName="animacion_fav.json"
        app:layout_constraintEnd_toEndOf="@id/iconFavorito"
        app:layout_constraintStart_toStartOf="@id/iconFavorito"
        app:layout_constraintTop_toTopOf="@id/iconFavorito"
        app:layout_constraintBottom_toBottomOf="@id/iconFavorito" />


</androidx.constraintlayout.widget.ConstraintLayout>






