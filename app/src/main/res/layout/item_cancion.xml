<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    tools:background="@color/black">

    <ImageView
        android:id="@+id/imagenCancion"
        android:layout_width="66dp"
        android:layout_height="64dp"
        android:background="@drawable/bordes_redondeados"
        android:clipToOutline="true"
        android:contentDescription="@string/descripcionImg"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        tools:ignore="UnusedAttribute" />

    <TextView
        android:id="@+id/nombreCancion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/abril_fatface"
        android:textColor="@color/blancoAgradables"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/ic_descargas"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/imagenCancion"
        app:layout_constraintTop_toTopOf="@id/imagenCancion"
        tools:text="Mohamed" />

    <TextView
        android:id="@+id/nombreArtista"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/abril_fatface"
        android:textColor="@color/grisSuave"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/ic_descargas"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/nombreCancion"
        app:layout_constraintTop_toBottomOf="@id/nombreCancion"
        tools:text="Artista" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/ic_descargas"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnAnadir"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_fileName="descargar_animation.json"
        app:lottie_loop="false"
        tools:ignore="ContentDescription" />

    <ImageButton
        android:id="@+id/btnAnadir"
        android:layout_width="30dp"
        android:layout_height="29dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_anadir"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iconFavorito"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/iconFavorito"
        android:layout_width="33dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/descripcionImg"
        android:src="@drawable/ic_favorito"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieFavorito"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/iconFavorito"
        app:layout_constraintEnd_toEndOf="@id/iconFavorito"
        app:layout_constraintStart_toStartOf="@id/iconFavorito"
        app:layout_constraintTop_toTopOf="@id/iconFavorito"
        app:lottie_autoPlay="false"
        app:lottie_fileName="animacion_fav.json"
        app:lottie_loop="false" />

    <ImageButton
        android:id="@+id/btnEliminar"
        android:layout_width="33dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_menos"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/iconFavorito"
        app:layout_constraintEnd_toEndOf="@id/iconFavorito"
        app:layout_constraintStart_toStartOf="@id/iconFavorito"
        app:layout_constraintTop_toTopOf="@id/iconFavorito" />

</androidx.constraintlayout.widget.ConstraintLayout>